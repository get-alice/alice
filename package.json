{
  "name": "alice",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "desktop": "cd apps/desktop && tauri dev",
    "desktop:build": "cd apps/desktop && tauri build",
    "check": "tsc --noEmit",
    "lint": "npm run lint:i18n && npm run lint:ts && npm run lint:rust",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "lint:fix": "eslint . --fix && cargo fmt --all",
    "test:smoke": "node scripts/smoke.mjs",
    "test:reader": "node scripts/test-reader.mjs",
    "test:html": "node scripts/test-html.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tauri-apps/api": "^2.10.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.26.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.0"
  }
}
