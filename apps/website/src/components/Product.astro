---
import Shot from './Shot.astro';
import appLight from '../assets/app-light.png';
import appDark from '../assets/app-dark.png';
---
<section class="product" id="product" aria-labelledby="product-title">
  <div class="wrap head">
    <h2 id="product-title" data-split>What's left is <em>your mail.</em></h2>
    <p class="lede" data-reveal>A quiet inbox, a reader that gets out of the way, and every action one key away. Gmail, Outlook and IMAP accounts side by side.</p>
  </div>
  <div class="stage" data-tilt-stage>
    <div class="window" data-tilt>
      <Shot light={appLight} dark={appDark} sizes="(min-width: 90rem) 84rem, 94vw" alt="Alice's inbox: folders on the left, a list of conversations, and an email from Sophie Chen open in the reader." />
    </div>
  </div>
</section>

<style>
  .product { padding: clamp(5rem, 12vw, 10rem) 0 clamp(4rem, 8vw, 7rem); }
  .head { display: grid; gap: 1.25rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .head h2 { max-width: 12ch; }
  .stage { perspective: 1800px; padding: 0 var(--gutter); }
  .window {
    max-width: 84rem; margin: 0 auto; border-radius: clamp(10px, 1.2vw, 18px); overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.4) inset, 0 50px 120px -50px rgb(var(--shade) / 0.55), 0 20px 40px -30px rgb(var(--shade) / 0.4);
    transform-origin: 50% 0;
  }
  .window :global(img) { display: block; width: 100%; height: auto; }
  @media (max-width: 60rem) {
    .product { padding-top: 2rem; }
    .head { margin-bottom: 1.5rem; }
  }
</style>
