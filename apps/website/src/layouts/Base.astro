---
import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';
import Flower from '../components/Flower.astro';
import { repo } from '../lib/release';

interface Props { title: string; description: string; jsonLd?: object[] }
const { title, description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, ''), Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
const sections = [['Product', '/#product'], ['Terminal', '/#terminal'], ['Privacy', '/#privacy'], ['FAQ', '/#faq']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#8fc8f0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alice" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="The Alice flower logo beside the wordmark alice. and the line: a lightweight client for email." />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <script is:inline>
      // Before first paint: pick the platform and theme. Content stays visible if modules fail.
      (function () {
        var root = document.documentElement;
        var ua = navigator.userAgent;
        var platform = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
        var touchMac = /Mac/.test(platform) && navigator.maxTouchPoints > 1;
        root.dataset.os = /iPhone|iPad|iPod|Android/i.test(ua) || touchMac ? 'other'
          : /Mac/i.test(platform) ? 'mac' : /Win/i.test(platform) ? 'windows' : /Linux|X11|CrOS/i.test(platform) ? 'linux' : 'other';
        // Day or night: a saved choice wins, otherwise follow the system.
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var system = matchMedia('(prefers-color-scheme: dark)');
        var apply = function () {
          var theme = saved === 'light' || saved === 'dark' ? saved : system.matches ? 'dark' : 'light';
          root.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#060914' : '#8fc8f0');
        };
        apply();
        system.addEventListener('change', function () {
          try { saved = localStorage.getItem('theme'); } catch (e) {}
          if (!saved) apply();
        });
      })();
    </script>
    {jsonLd.map(data => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="top-sentinel" aria-hidden="true" data-top></div>
    <div class="sky" aria-hidden="true"></div>
    <canvas class="air" aria-hidden="true" data-air></canvas>
    <header class="nav" data-nav>
      <div class="nav-inner">
        <a class="wordmark" href="/" aria-label="Alice home">
          <Flower class="wordmark-flower" />
          <span aria-hidden="true">alice<span class="dot"></span></span>
        </a>
        <nav aria-label="Main" class="nav-links">
          {sections.map(([label, href]) => <a {href}>{label}</a>)}
        </nav>
        <div class="nav-end">
          <details class="nav-explore" data-explore>
            <summary aria-label="Explore page sections"><Icon name="list" size={22} /></summary>
            <nav aria-label="Page sections">
              {sections.map(([label, href]) => <a {href}>{label}</a>)}
              <a class="source-link" href={repo}>Source code on GitHub</a>
            </nav>
          </details>
          <button class="icon-link theme-toggle" type="button" data-theme-toggle aria-label="Switch to night">
            <span class="to-dark"><Icon name="moon" size={21} /></span>
            <span class="to-light"><Icon name="sun" size={21} /></span>
          </button>
          <a class="icon-link github-link" href={repo} aria-label="Alice on GitHub"><Icon name="github-logo" size={22} /></a>
          <a class="button primary small" href="/#download">Get Alice</a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <canvas class="footer-meadow" aria-hidden="true" data-meadow data-ground></canvas>
      <div class="footer-inner">
        <p class="footer-line">A lightweight client for email. Free software under the <a href={`${repo}/blob/main/LICENSE`}>GNU AGPL v3</a>.</p>
        <nav aria-label="Footer">
          <ul>
            <li><a href="/#download">Get Alice</a></li>
            <li><a href={repo}>Source code</a></li>
            <li><a href={`${repo}/issues`}>Report an issue</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </nav>
      </div>
      <p class="footer-mark" aria-hidden="true">alice<span class="dot"></span></p>
    </footer>
    <script>
      import '../scripts/nature';
      import '../scripts/theme';
      // Frost the navigation once the page has moved.
      const nav = document.querySelector('[data-nav]')!;
      new IntersectionObserver(([entry]) => nav.classList.toggle('scrolled', !entry.isIntersecting)).observe(document.querySelector('[data-top]')!);
      const explore = document.querySelector<HTMLDetailsElement>('[data-explore]')!;
      document.addEventListener('click', event => {
        if (!explore.contains(event.target as Node) || (event.target as Element).closest('a')) explore.open = false;
      });
      explore.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          explore.open = false;
          explore.querySelector('summary')!.focus();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #eef5fb;
    --bg-raise: #fdfeff;
    --bg-sunk: #e4edf5;
    --ink: #1c1a23;
    --ink-2: #38405a;
    --ink-3: #414660;
    --line: rgb(28 26 35 / 0.1);
    --line-strong: rgb(28 26 35 / 0.18);
    --violet: #5e4691;
    --lavender: #8770b5;
    --petal: #eeebf8;
    --fill: #5e4691;
    --fill-hover: #4e3a7b;
    --on-fill: #fdfcff;
    --shade: 60 90 130;
    --sky-1: #8fc8f0;
    --sky-2: #c1e1f7;
    --sky-3: #eef5fb;
    --sun: 255 247 214;
    --grass-far: #b5da97;
    --grass-mid: #98ca78;
    --grass-near: #7db65f;
    --ground: #74ad57;
    --forest: #1f3a1c;
    --seed: 142 158 182;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    --gutter: clamp(1rem, 4vw, 3rem);
    --max: 90rem;
    color-scheme: light;
    interpolate-size: allow-keywords;
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0d1120;
    --bg-raise: #161b2c;
    --bg-sunk: #080b16;
    --ink: #eeecf4;
    --ink-2: #a8a4b5;
    --ink-3: #9da4c4;
    --line: rgb(238 236 244 / 0.09);
    --line-strong: rgb(238 236 244 / 0.16);
    --violet: #c3aef0;
    --lavender: #a58fd6;
    --petal: #241e31;
    --fill: #b49be1;
    --fill-hover: #c7b3ee;
    --on-fill: #17131f;
    --shade: 0 0 0;
    --sky-1: #04060e;
    --sky-2: #0a0f27;
    --sky-3: #161c3e;
    --sun: 226 222 255;
    --grass-far: #1d3a2b;
    --grass-mid: #183324;
    --grass-near: #132a1d;
    --ground: #102419;
    --forest: #cfe6c6;
    --seed: 220 224 240;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; overflow-x: clip; }
  body {
    margin: 0;
    background: var(--bg);
    position: relative;
    color: var(--ink);
    font: 400 1.0625rem/1.6 var(--font-sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: clip;
  }
  h1, h2, h3 { font-family: var(--font-serif); font-weight: 400; line-height: 1.02; margin: 0; letter-spacing: -0.03em; text-wrap: balance; }
  h2 { font-size: clamp(2.5rem, 1.5rem + 4vw, 5.25rem); }
  h1 em, h2 em, h3 em { font-style: italic; color: var(--violet); letter-spacing: -0.035em; }
  p { margin: 0; text-wrap: pretty; }
  a { color: var(--violet); text-underline-offset: 0.18em; }
  :focus-visible { outline: 2px solid var(--violet); outline-offset: 3px; border-radius: 6px; }
  ::selection { background: var(--petal); color: var(--ink); }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .wrap { width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
  .lede { font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem); color: var(--ink-2); max-width: 38rem; line-height: 1.55; }
  .dot { display: inline-block; width: 0.17em; height: 0.17em; margin-left: 0.04em; border-radius: 50%; background: var(--lavender); }

  /* A clear sky that stays put behind the page, and the air that drifts across it. */
  .sky { position: fixed; inset: 0; z-index: -2; background: linear-gradient(180deg, var(--sky-1) 0%, var(--sky-2) 42%, var(--sky-3) 92%); }
  [data-theme="dark"] .sky::after {
    content: ''; position: absolute; inset: 0; opacity: 0.8;
    background:
      radial-gradient(1px 1px at 12% 18%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 27% 8%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 41% 23%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 58% 12%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 69% 31%, #fff 50%, transparent 51%), radial-gradient(1.5px 1.5px at 83% 9%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 92% 26%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 6% 37%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 35% 41%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 76% 47%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 19% 55%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 52% 58%, #fff 50%, transparent 51%);
  }
  .air { position: fixed; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
  main { position: relative; }
  section[id] { scroll-margin-top: 8rem; }

  .top-sentinel { position: absolute; top: 0; left: 0; width: 1px; height: 24px; pointer-events: none; }
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 30; padding: 0.6rem 1rem; border-radius: 10px; background: var(--ink); color: var(--bg); }
  .skip:focus { top: 1rem; }

  /* Navigation: transparent over the hero, a frosted bar once the page moves. */
  .nav { position: fixed; inset: 0 0 auto; z-index: 20; padding: 0.75rem var(--gutter); pointer-events: none; }
  .nav-inner {
    pointer-events: auto;
    position: relative; max-width: calc(var(--max) - 2 * var(--gutter)); margin: 0 auto; min-height: 3.5rem;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.25rem 0.5rem;
    padding: 0.3rem 0.5rem 0.3rem 0.9rem; border-radius: 2rem; border: 1px solid transparent;
    transition: background-color 400ms var(--ease-out), border-color 400ms var(--ease-out), box-shadow 400ms var(--ease-out);
  }
  .nav.scrolled .nav-inner {
    background: color-mix(in oklab, var(--bg) 72%, transparent);
    border-color: var(--line);
    box-shadow: 0 10px 30px -18px rgb(var(--shade) / 0.35);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
  }
  @media (prefers-reduced-transparency: reduce) { .nav.scrolled .nav-inner { background: var(--bg); backdrop-filter: none; } }
  .wordmark { display: inline-flex; align-items: center; min-height: 2.75rem; gap: 0.5rem; color: var(--ink); text-decoration: none; font: 600 1.45rem/1 var(--font-sans); letter-spacing: -0.04em; width: fit-content; }
  .wordmark-flower { width: 1.6rem; height: 1.6rem; color: var(--lavender); }
  .nav-links { position: absolute; left: 50%; translate: -50% 0; display: flex; gap: 0.25rem; }
  .nav-links a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--ink-2); text-decoration: none; font-size: 0.95rem; font-weight: 500; padding: 0.5rem 0.85rem; border-radius: 999px; transition: color 200ms, background-color 200ms; }
  .nav-end { display: flex; flex-wrap: wrap; min-width: 0; justify-content: flex-end; align-items: center; gap: 0.5rem; margin-inline-start: auto; }
  .nav-explore { display: none; }
  .nav-explore summary { display: grid; place-items: center; width: 2.75rem; min-height: 2.75rem; cursor: pointer; color: var(--ink-2); border-radius: 50%; list-style: none; }
  .nav-explore summary::-webkit-details-marker { display: none; }
  .nav-explore[open] summary { background: var(--petal); color: var(--violet); }
  .nav-explore nav { position: absolute; top: calc(100% + 0.5rem); right: 0; width: min(18rem, calc(100vw - 2 * var(--gutter))); padding: 0.5rem; border-radius: 16px; background: var(--bg-raise); box-shadow: 0 16px 36px -14px rgb(var(--shade) / 0.5); }
  .nav-explore a { display: flex; align-items: center; min-height: 2.75rem; padding: 0.5rem 0.75rem; color: var(--ink); text-decoration: none; border-radius: 8px; }
  .nav-explore a:hover { background: var(--petal); }
  .nav-explore .source-link { margin-top: 0.25rem; border-top: 1px solid var(--line); color: var(--violet); }
  .theme-toggle { border: 0; background: none; padding: 0; cursor: pointer; font: inherit; }
  .theme-toggle span { display: grid; transition: rotate 500ms var(--ease-out), scale 300ms var(--ease-out); }
  .theme-toggle .to-light, [data-theme="dark"] .theme-toggle .to-dark { display: none; }
  [data-theme="dark"] .theme-toggle .to-light { display: grid; }
  @media (hover: hover) and (pointer: fine) { .theme-toggle:hover span { rotate: 20deg; } }
  .theme-toggle:active span { scale: 0.85; }
  /* The new theme opens as a circle from the switch; see scripts/theme.ts. */
  ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
  .icon-link { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; flex: none; border-radius: 999px; color: var(--ink-2); transition: color 200ms, background-color 200ms; }
  @media (hover: hover) and (pointer: fine) {
    .nav-links a:hover, .icon-link:hover { color: var(--ink); background: var(--line); }
  }
  @media (max-width: 60rem) {
    .nav-links, .github-link { display: none; }
    .nav-explore { display: block; }
    .nav-inner { padding-inline: 0.5rem; }
    .nav-end { gap: 0.25rem; }
    .wordmark { font-size: 1.3rem; gap: 0.35rem; }
  }

  .button {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    min-height: 3.25rem; max-width: 100%; padding: 0.8rem 1.6rem; border-radius: 999px; text-align: center;
    font: 500 1rem/1.2 var(--font-sans); text-decoration: none; cursor: pointer;
    border: 1px solid transparent;
    transition: background-color 200ms ease, border-color 200ms ease, box-shadow 250ms ease, transform 160ms var(--ease-out);
  }
  .button:active { transform: scale(0.97); }
  .button.small { min-height: 2.75rem; padding: 0.5rem 1rem; font-size: 0.92rem; }
  .button.primary { background: var(--fill); color: var(--on-fill); box-shadow: 0 1px 0 rgb(255 255 255 / 0.2) inset, 0 10px 26px -12px rgb(var(--shade) / 0.7); }
  .button.ghost { color: var(--ink); border-color: var(--line-strong); background: color-mix(in oklab, var(--bg-raise) 60%, transparent); }
  @media (hover: hover) and (pointer: fine) {
    .button.primary:hover { background: var(--fill-hover); }
    .button.ghost:hover { border-color: var(--ink-3); background: var(--bg-raise); }
  }

  /* Masks leave room for italic overhang and descenders; text is visible before enhancement. */
  [data-split] > div { padding: 0 0.08em 0.14em; margin: 0 -0.08em -0.14em; }

  /* One download link per platform; the inline script in <head> shows the visitor's. */
  .os:not(.os-other), [data-os] .os { display: none; }
  [data-os="mac"] .os-mac, [data-os="windows"] .os-windows, [data-os="linux"] .os-linux, [data-os="other"] .os-other { display: inline-flex; }

  /* The page ends standing in the meadow. */
  .footer { position: relative; margin-top: clamp(6rem, 12vw, 10rem); padding: 2.5rem 0 0; background: var(--ground); color: var(--forest); }
  .footer-meadow { position: absolute; left: 0; right: 0; bottom: 100%; width: 100%; height: clamp(6rem, 14vw, 11rem); pointer-events: none; }
  .footer-inner { position: relative; max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem 3rem; }
  .footer-line { font-size: 0.95rem; max-width: 30rem; }
  .footer a { color: var(--forest); }
  .footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .footer li a { display: inline-flex; align-items: center; min-width: 2.75rem; min-height: 2.75rem; text-decoration: none; font-size: 0.95rem; font-weight: 500; }
  .footer :focus-visible { outline-color: var(--forest); }
  @media (hover: hover) and (pointer: fine) { .footer li a:hover { text-decoration: underline; } }
  .footer-mark {
    position: relative; margin: 2rem 0 0; height: 0.62em; overflow: hidden; text-align: center; color: var(--forest);
    font: 600 clamp(6rem, 29vw, 30rem)/0.74 var(--font-sans); letter-spacing: -0.07em; opacity: 0.92;
  }
  .footer-mark .dot { background: var(--lavender); }
</style>
