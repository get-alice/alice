---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Product from '../components/Product.astro';
import Small from '../components/Small.astro';
import Mirror from '../components/Mirror.astro';
import Cheshire from '../components/Cheshire.astro';
import Wonders from '../components/Wonders.astro';
import Private from '../components/Private.astro';
import Download from '../components/Download.astro';
import { latestRelease, repo } from '../lib/release';

const release = await latestRelease();
const site = Astro.site!.href.replace(/\/$/, '');
const description = 'Alice is a free, open-source email client for macOS, Windows and Linux. A calm desktop inbox, a terminal app, and optional AI with your own key. Your mail stays on your device.';

const faq = [
  ['Is Alice free?', 'Yes. Alice is free and open source under the GNU AGPL v3. There is no account to create and no subscription.'],
  ['Which email accounts work with Alice?', 'Gmail and Outlook sign in through your browser. Any other provider that offers IMAP and SMTP works too, including iCloud, Fastmail and your own mail server.'],
  ['Does Alice keep my email on a server?', 'No. There is no Alice server. Alice talks directly to your mail provider and keeps a copy of your mail in a database on your device. Passwords and sign-in tokens are stored in your system keychain.'],
  ['How does the AI in Alice work?', 'It is optional and uses your own API key with OpenAI, Anthropic or any OpenAI-compatible service, including models running on your own machine. Alice sends only the message you ask about, or your newest 20 inbox messages for questions about the inbox, straight to the provider you chose.'],
  ['Can I use Alice from the terminal?', 'Yes. The alice command opens a full terminal app, and commands such as alice list --json make your mail scriptable. The terminal and desktop apps share one local service, so they always show the same mail and drafts.'],
  ['Which platforms does Alice run on?', 'macOS, Windows and Linux. Android and iOS are planned.'],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Alice',
    description,
    url: `${site}/`,
    downloadUrl: `${site}/#download`,
    applicationCategory: 'CommunicationApplication',
    applicationSubCategory: 'Email client',
    operatingSystem: 'macOS, Windows, Linux',
    ...(release.version ? { softwareVersion: release.version } : {}),
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    image: `${site}/og.png`,
    sameAs: [repo],
    featureList: [
      'Gmail, Outlook and IMAP/SMTP accounts in one inbox',
      'Keyboard shortcuts for every action',
      'Optional AI summaries and drafts with your own OpenAI, Anthropic or local model',
      'Answer calendar invitations from the email',
      'Remote images blocked until you allow them',
      'Terminal app and scriptable command line',
    ],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Alice', url: `${site}/` },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base title="Alice, a lightweight client for email" {description} {jsonLd}>
  <Hero {release} />
  <Product />
  <Small />
  <Mirror />
  <Cheshire />
  <Wonders />
  <Private />
  <Download {release} />
  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="wrap grid">
      <h2 id="faq-title" data-split>Questions, <em>answered.</em></h2>
      <div class="qs">
        {faq.map(([q, a]) => (
          <details data-reveal>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/story';
</script>

<style>
  .faq { padding: clamp(4rem, 8vw, 7rem) 0 clamp(5rem, 10vw, 8rem); }
  .grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem var(--gutter); align-items: start; }
  h2 { font-size: clamp(2.4rem, 1.6rem + 2.8vw, 4.25rem); position: sticky; top: 7rem; }
  .qs { border-top: 1px solid var(--line-strong); }
  details { border-bottom: 1px solid var(--line-strong); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.35rem 0.25rem; font: 400 clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem)/1.3 var(--font-serif); letter-spacing: -0.01em; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex: none; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--line-strong); font: 300 1.2rem/1 var(--font-sans); color: var(--violet); transition: transform 300ms var(--ease-out), background-color 200ms; }
  details::details-content { block-size: 0; overflow: clip; transition: block-size 400ms var(--ease-out), content-visibility 400ms allow-discrete; }
  details[open]::details-content { block-size: auto; }
  details[open] summary::after { transform: rotate(45deg); background: var(--petal); }
  details p { padding: 0 0.25rem 1.5rem; max-width: 62ch; color: var(--ink-2); }
  @media (prefers-reduced-motion: reduce) { summary::after, details::details-content { transition: none; } }
  @media (max-width: 56rem) { .grid { grid-template-columns: 1fr; } h2 { position: static; } }
</style>
