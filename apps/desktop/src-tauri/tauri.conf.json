{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alice",
  "version": "0.1.0",
  "identifier": "email.getalice.alice",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev:web",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [{
      "title": "Alice",
      "width": 1440,
      "height": 950,
      "minWidth": 850,
      "minHeight": 640,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "backgroundColor": "#f7f7f9"
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Email client",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "de.lproj/InfoPlist.strings": "de.lproj/InfoPlist.strings"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" }
  }
}
